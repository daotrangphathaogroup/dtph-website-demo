{
  "name": "phat-hao-member-portal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build && node scripts/check-deployment-trace.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:migrate": "node --env-file=.env.production scripts/migrate.mjs",
    "admin:promote": "node --env-file=.env.production scripts/promote-admin.mjs",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@electric-sql/pglite": "^0.5.8",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": "24.x"
  }
}

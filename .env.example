# Local dev remains PGlite; these variables are for Vercel/server scripts only.
# Never prefix any secret below with NEXT_PUBLIC_.
APP_ORIGIN=https://your-project.vercel.app
# Supabase Connect > Transaction pooler (port 6543). URL-encode password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Migration uses Direct connection or Session pooler; do not add to Vercel.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Optional PEM certificate from Supabase, if needed for CA validation.
DATABASE_SSL_CA=
# Generate a random secret locally, at least 32 characters; keep stable across deployments.
OTP_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=phat-hao-avatars
# disabled blocks login/registration; never use a mock provider in production.
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Alternatively use TWILIO_FROM instead of Messaging Service SID.
TWILIO_FROM=

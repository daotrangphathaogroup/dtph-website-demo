# Next dev uses persistent PGlite locally. These secrets are for cloud only.
APP_ORIGIN=https://your-project.vercel.app
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres
# Local migration/admin CLI only; never place this variable in NEXT_PUBLIC_*.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL_CA=
# Stable server secret >=32 characters for admin login rate limits.
ADMIN_SESSION_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=phat-hao-avatars
